---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Stats from '../components/home/Stats.astro';
import Experience from '../components/home/Experience.astro';
import Writing from '../components/home/Writing.astro';
import Projects from '../components/home/Projects.astro';
import Skills from '../components/home/Skills.astro';
import Education from '../components/home/Education.astro';
import Contact from '../components/home/Contact.astro';
import { avatar } from '../lib/avatar';
import { personSchema, websiteSchema } from '../lib/jsonld';
import { getAllPosts } from '../lib/posts';
import { site } from '../data/site';

const posts = await getAllPosts();
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const avatarUrl = avatar && new URL((await getImage({ src: avatar, format: 'webp', width: 512 })).src, siteUrl).href;
---

<BaseLayout current="home" jsonLd={[personSchema(siteUrl, avatarUrl), websiteSchema(siteUrl, site.title)]}>
  <Hero />
  <Stats postCount={posts.length} />
  <Experience />
  <Writing posts={posts.slice(0, 5)} total={posts.length} />
  <Projects />
  <Skills />
  <Education />
  <Contact />
</BaseLayout>
