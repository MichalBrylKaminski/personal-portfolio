---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Monogram from '../../components/Monogram.astro';
import { basics, labelParts, monthRange } from '../../lib/cv';
import { breadcrumbSchema, softwareSchema } from '../../lib/jsonld';
import { getCaseStudies } from '../../lib/projects';

export const getStaticPaths = (async () => {
  const caseStudies = await getCaseStudies();
  return caseStudies.map((caseStudy) => ({ params: { slug: caseStudy.project.slug }, props: { caseStudy } }));
}) satisfies GetStaticPaths;

const { entry, project } = Astro.props.caseStudy;
const { Content } = await render(entry);
const { description, draft } = entry.data;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
---

<BaseLayout
  title={`${project.name} — case study`}
  description={description}
  current="project"
  jsonLd={[
    softwareSchema(siteUrl, project, description),
    breadcrumbSchema(siteUrl, [
      { name: 'Home', path: '/' },
      { name: 'Projects', path: '/#projects' },
      { name: project.name, path: `/projects/${project.slug}/` },
    ]),
  ]}
>
  <article class="wrap max-w-[816px]! pt-10 pb-16 lg:pt-20 lg:pb-30">
    <a href="/#projects" class="caption flex items-center gap-2 hover:text-accent">
      <Icon name="arrow-left" size={13} strokeWidth={2} /> All projects
    </a>

    <header class="mt-8 flex flex-col gap-5 border-b border-border pb-10">
      <p class="caption flex flex-wrap items-center gap-3 tracking-[0.12em]">
        {draft && <span class="tag tag-accent h-6 text-[10px] tracking-[0.1em] uppercase">Draft</span>}
        <span>Case study</span>
        <span aria-hidden="true">·</span>
        <span>{monthRange(project)}</span>
      </p>
      <h1 class="text-[36px] leading-[1.08] font-semibold tracking-[-0.01em] text-ink lg:text-[52px]">{project.name}</h1>
      <p class="text-lg leading-relaxed text-ink-2">{description}</p>
      {
        project.highlights.length > 0 && (
          <ul class="flex flex-wrap gap-1.5">
            {project.highlights.map((highlight) => (
              <li class="tag">{highlight}</li>
            ))}
          </ul>
        )
      }
      {
        project.url && (
          <a href={project.url} class="btn btn-outline-accent self-start" rel="noopener">
            Visit {new URL(project.url).hostname} <Icon name="arrow-up-right" size={14} strokeWidth={2} />
          </a>
        )
      }
    </header>

    <div class="prose prose-post prose-lg mt-10 max-w-none">
      <Content />
    </div>

    <footer class="card mt-16 flex flex-col gap-4 p-6 sm:flex-row sm:items-center">
      <Monogram class="size-[52px] shrink-0 text-lg" />
      <div class="flex flex-1 flex-col gap-1">
        <p class="text-lg font-semibold text-ink">{basics.name}</p>
        <p class="caption text-[10px] tracking-[0.12em]">{labelParts.join(' · ')}</p>
      </div>
      <a href="/" class="btn">View portfolio <Icon name="arrow-right" size={14} strokeWidth={2} /></a>
    </footer>
  </article>
</BaseLayout>
