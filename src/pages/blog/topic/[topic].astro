---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogIndex from '../../../components/blog/BlogIndex.astro';
import { basics } from '../../../lib/cv';
import { breadcrumbSchema } from '../../../lib/jsonld';
import { getAllPosts, getTopics } from '../../../lib/posts';
import { site } from '../../../data/site';

export const getStaticPaths = (async () => {
  const posts = await getAllPosts();
  return getTopics(posts).map((topic) => ({ params: { topic: topic.slug }, props: { topic } }));
}) satisfies GetStaticPaths;

const { topic } = Astro.props;
const posts = await getAllPosts();
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const topicPosts = posts.filter((post) => post.topic === topic.name);
const description = `${topicPosts.length} ${topicPosts.length === 1 ? 'article' : 'articles'} on ${topic.name} by ${basics.name}, from the blog "${site.blog.title}".`;
---

<BaseLayout
  title={`${topic.name} posts`}
  description={description}
  current="blog"
  jsonLd={[
    breadcrumbSchema(siteUrl, [
      { name: 'Home', path: '/' },
      { name: 'Blog', path: '/blog/' },
      { name: topic.name, path: `/blog/topic/${topic.slug}/` },
    ]),
  ]}
>
  <BlogIndex
    posts={topicPosts}
    totalCount={posts.length}
    topics={getTopics(posts)}
    activeTopic={topic.slug}
  />
</BaseLayout>
