---
interface Props {
  index: string;
  label: string;
  title: string;
}

const { index, label, title } = Astro.props;
---

<div class="mb-7 flex flex-col gap-4 lg:mb-10 lg:flex-row lg:items-end lg:justify-between lg:gap-6">
  <div class="flex flex-col gap-3.5">
    <p class="caption flex items-center gap-2.5">
      <span class="text-accent">{index}</span>
      <span class="h-px w-6 bg-border-strong"></span>
      {label}
    </p>
    <h2 class="text-[34px] leading-[1.05] font-semibold tracking-[-0.01em] text-ink lg:text-[44px]">{title}</h2>
    <slot name="intro" />
  </div>
  <slot />
</div>
