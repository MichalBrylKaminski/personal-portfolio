---
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import { isCurrent, monthRange, projects } from '../../lib/cv';
import { getCaseStudySlugs } from '../../lib/projects';

const caseStudies = await getCaseStudySlugs();
---

{
  projects.length > 0 && (
    <section id="projects" class="wrap pb-16 lg:pb-30">
      <SectionHeading index="03" label="Projects" title="What I'm building" />

      <ul class="grid grid-cols-1 gap-2.5 lg:gap-4">
        {projects.map((project) => (
          <li class="card flex flex-col gap-4 p-5 lg:gap-5 lg:p-8">
            <div class="flex flex-col gap-2 lg:flex-row lg:items-center lg:justify-between lg:gap-6">
              <h3 class="text-[22px] font-semibold text-ink lg:text-[28px]">{project.name}</h3>
              <p class="caption flex items-center gap-2 text-[10px] tracking-[0.12em]">
                {isCurrent(project) && <span class="size-1.5 rounded-[2px] bg-accent" aria-hidden="true" />}
                {monthRange(project)}
              </p>
            </div>
            {project.description && <p class="max-w-3xl text-base leading-relaxed text-ink-2">{project.description}</p>}
            {project.highlights.length > 0 && (
              <ul class="flex flex-wrap gap-1.5">
                {project.highlights.map((highlight) => (
                  <li class="tag">{highlight}</li>
                ))}
              </ul>
            )}
            <div class="flex flex-wrap gap-2.5">
              {caseStudies.has(project.slug) && (
                <a href={`/projects/${project.slug}/`} class="btn btn-primary">
                  Read case study <Icon name="arrow-right" size={14} strokeWidth={2} />
                </a>
              )}
              {project.url && (
                <a href={project.url} class="btn btn-outline-accent" rel="noopener">
                  Visit {new URL(project.url).hostname} <Icon name="arrow-up-right" size={14} strokeWidth={2} />
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}
