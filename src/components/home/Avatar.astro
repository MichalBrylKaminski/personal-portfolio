---
import { Image } from 'astro:assets';
import { avatar } from '../../lib/avatar';
import { basics } from '../../lib/cv';

interface Props {
  size: number;
  class?: string;
}

const { size, class: className } = Astro.props;
const initials = basics.name
  .split(/\s+/)
  .map((part) => part[0])
  .join('')
  .slice(0, 2);
---

{
  avatar ? (
    <Image
      src={avatar}
      alt={basics.name}
      width={size}
      height={size}
      densities={[1, 2]}
      format="webp"
      loading="eager"
      class:list={['rounded-full border border-border object-cover', className]}
      style={{ width: `${size}px`, height: `${size}px` }}
    />
  ) : (
    <div
      class:list={[
        'flex items-center justify-center rounded-full border border-border bg-surface-2 font-semibold text-border-strong',
        className,
      ]}
      style={{ width: `${size}px`, height: `${size}px`, fontSize: `${Math.round(size * 0.3)}px` }}
      aria-hidden="true"
    >
      {initials}
    </div>
  )
}
