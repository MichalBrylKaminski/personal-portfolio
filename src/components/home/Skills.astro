---
import SectionHeading from '../SectionHeading.astro';
import { cv, skillLevel } from '../../lib/cv';
---

<section id="stack" class="wrap pb-16 lg:pb-30">
  <SectionHeading index="03" label="Stack" title="Tools I reach for" />

  <ul class="grid grid-cols-1 gap-2.5 md:grid-cols-2 lg:grid-cols-3 lg:gap-4">
    {
      cv.skills.map((skill) => {
        const level = skillLevel(skill.level);
        return (
          <li class="card flex flex-col gap-4 p-5 lg:gap-[18px] lg:p-6">
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-lg font-semibold text-ink lg:text-[22px]">{skill.name}</h3>
              {skill.level && (
                <div class="flex items-center gap-2.5">
                  <span class="caption text-[10px] tracking-[0.12em]">{skill.level}</span>
                  <span class="flex gap-[3px]" aria-hidden="true">
                    {[0, 1, 2, 3].map((bar) => (
                      <span class:list={['h-4 w-[3px] rounded-[2px]', bar < level ? 'bg-accent' : 'bg-border-strong']} />
                    ))}
                  </span>
                </div>
              )}
            </div>
            {skill.keywords && skill.keywords.length > 0 && (
              <ul class="flex flex-wrap gap-1.5">
                {skill.keywords.map((keyword) => (
                  <li class="tag">{keyword}</li>
                ))}
              </ul>
            )}
          </li>
        );
      })
    }
    {
      cv.languages.length > 0 && (
        <li class="card flex flex-col gap-3.5 p-5 lg:p-6">
          <h3 class="text-lg font-semibold text-ink lg:text-[22px]">Languages</h3>
          <dl class="flex flex-col">
            {cv.languages.map((language) => (
              <div class="flex h-9 items-center justify-between border-b border-border last:border-b-0">
                <dt class="text-[15px] text-ink">{language.language}</dt>
                <dd class="caption text-[10px] tracking-[0.12em]">{language.fluency}</dd>
              </div>
            ))}
          </dl>
        </li>
      )
    }
  </ul>
</section>
