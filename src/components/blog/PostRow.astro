---
import Icon from '../Icon.astro';
import { formatDay } from '../../lib/dates';
import type { PostSummary } from '../../lib/posts';

interface Props {
  post: PostSummary;
}

const { post } = Astro.props;
---

<li class="border-b border-border">
  <a
    href={post.href}
    class="group flex flex-col gap-2.5 py-[22px] lg:grid lg:grid-cols-[128px_minmax(0,1fr)_20px] lg:gap-6"
  >
    <span class="flex items-center gap-2.5 lg:flex-col lg:items-start lg:pt-1">
      <time datetime={post.date.toISOString()} class="font-mono text-xs tracking-[0.04em] text-muted">
        {formatDay(post.date)}
      </time>
      <span class="tag h-[22px] px-[7px] text-[10px] tracking-[0.1em] uppercase">{post.topic}</span>
    </span>
    <span class="flex min-w-0 flex-col gap-1.5">
      <span class="text-lg leading-tight font-semibold text-ink group-hover:text-accent lg:text-[21px]">{post.title}</span>
      <span class="text-[15px] leading-normal text-ink-2">{post.summary}</span>
    </span>
    <Icon
      name={post.publisher ? 'arrow-up-right' : 'arrow-right'}
      size={18}
      class="mt-1.5 hidden text-muted group-hover:text-accent lg:block"
    />
  </a>
</li>
