---
import '@fontsource/chakra-petch/400.css';
import '@fontsource/chakra-petch/500.css';
import '@fontsource/chakra-petch/600.css';
import '@fontsource/chakra-petch/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';

import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import JsonLd from '../components/JsonLd.astro';
import { site } from '../data/site';
import { publicFileExists } from '../lib/files';

interface Props {
  title?: string;
  description?: string;
  current: 'home' | 'blog' | 'project';
  type?: 'website' | 'article';
  /** Structured data (schema.org objects) to embed as JSON-LD. */
  jsonLd?: object[];
}

const { title, description = site.description, current, type = 'website', jsonLd = [] } = Astro.props;
const fullTitle = title ? `${title} — ${site.title}` : `${site.title} — ${site.tagline}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogImage = Astro.site && publicFileExists('/og.png') ? new URL('/og.png', Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#11110f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.title} — Blog`} href="/rss.xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={`${site.title} — ${site.tagline}`} />
          <meta name="twitter:image" content={ogImage} />
        </>
      )
    }
    {jsonLd.length > 0 && <JsonLd data={jsonLd} />}
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="btn btn-primary sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      Skip to content
    </a>
    <SiteHeader current={current} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { inject } from '@vercel/analytics';
      inject();
    </script>
  </body>
</html>
