# Copy to .env (gitignored). Used only by `npm run sync:notion`.
# Create an internal integration at https://www.notion.so/profile/integrations, then share the
# Posts database with it (database ... menu > Connections).
NOTION_TOKEN=
# The database's own ID: the 32-character part of its URL, before "?v=".
NOTION_POSTS_DATABASE_ID=
